# ==============================================================================
# SWYNEX Technologies - Model or API Integration
# Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env` in the project root:
#    cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# 2. Populate your actual API keys below as needed.
# 3. DO NOT commit your `.env` file to version control.
# ==============================================================================

# Option 1: Hugging Face Inference API Token (Optional if using Local HF Pipeline)
# Get your free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_huggingface_api_token_here

# Option 2: Google Gemini API Key (Optional for Public AI API mode)
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration
APP_ENV=development
DEFAULT_MODEL_MODE=local_hf_pipeline
